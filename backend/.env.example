AH_CORS_ORIGINS=http://localhost:5173

# Text perception: auto uses an OpenAI-compatible endpoint when URL/model are set,
# otherwise the deterministic offline parser. Use openai_compatible to fail loudly.
AH_PARSER_PROVIDER=auto
AH_LLM_BASE_URL=
AH_LLM_MODEL=
AH_LLM_API_KEY=
AH_LLM_TIMEOUT_SECONDS=45
AH_LLM_MAX_TOKENS=8192
AH_ANSWER_MAX_TOKENS=2048
AH_INGESTION_INITIAL_WEIGHT=1.0
AH_LLM_RESPONSE_FORMAT=json_schema

# OpenRouter Ox Alpha preset (JSON output, no schema enforcement):
# AH_LLM_BASE_URL=https://openrouter.ai/api/v1
# AH_LLM_MODEL=deepseek/deepseek-v4-flash-0731:nitro
# AH_LLM_RESPONSE_FORMAT=json_object

# DeepSeek V4 Flash can also be selected in the Ingestion UI and uses JSON Schema:
# AH_LLM_MODEL=~deepseek/deepseek-v4-flash-latest
# AH_LLM_RESPONSE_FORMAT=json_schema

# Optional Neo4j Community projection (in-memory is default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
